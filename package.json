{
  "name": "umami-badges",
  "version": "1.0.0",
  "description": "Generate badges for your Umami analytics data",
  "main": "api/api.js",
  "scripts": {
    "start": "node api/api.js",
    "dev": "concurrently -k -n api,vite \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "node api/api.js",
    "dev:vite": "vite",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "vite": "^8.3.3"
  },
  "overrides": {
    "argparse": "^2.0.1",
    "concurrently": {
      "shell-quote": "^1.11.0"
    },
    "jest-environment-jsdom": {
      "jsdom": "^27.4.0"
    },
    "glob": "^13.0.6"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "api/api.js",
      "src/script.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "transform": {}
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
