{
  "name": "umami-badges",
  "version": "1.0.0",
  "description": "Generate badges for your Umami analytics data",
  "main": "api/api.js",
  "scripts": {
    "start": "node api/api.js",
    "dev": "node api/api.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "api/api.js",
      "src/script.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "transform": {}
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.6",
    "node-fetch": "^2.6.9",
    "node-cache": "^5.1.2"
  },
  "engines": {
    "node": ">=16"
  }
}
