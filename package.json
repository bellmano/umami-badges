{
  "name": "umami-badges",
  "version": "1.0.0",
  "description": "Generate badges for your Umami analytics data",
  "main": "api/api.js",
  "scripts": {
    "start": "node api/api.js",
    "dev": "node api/api.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "api/api.js",
      "src/script.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "transform": {}
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0"
  },
  "engines": {
    "node": ">=16"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
