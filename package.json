{
  "name": "umami-badges",
  "version": "1.0.0",
  "description": "Generate badges for your Umami analytics data",
  "main": "api/api.js",
  "scripts": {
    "start": "node api/api.js",
    "dev": "concurrently -k -n api,vite \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "node api/api.js",
    "dev:vite": "vite",
    "test": "vitest run --globals --environment jsdom",
    "test:coverage": "vitest run --globals --environment jsdom --coverage --coverage.provider=istanbul --coverage.include=api/api.js --coverage.include=src/script.js --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.1.0",
    "concurrently": "^10.0.7",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "argparse": "^2.0.1",
    "concurrently": {
      "shell-quote": "^1.11.0"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "node-cache": "^5.1.2"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
